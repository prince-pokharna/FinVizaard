# FinVizaard Environment Variables
# Copy this file to .env and insert your API keys

# News API Key (obtain free from https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# Anthropic Claude API Key (obtain from https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (obtain from https://platform.openai.com/ - optional)
OPENAI_API_KEY=your_openai_api_key_here
